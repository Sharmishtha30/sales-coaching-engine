# Export these variables into the server/MCP process. No .env is auto-loaded.
COACH_API_TOKEN=replace-with-a-long-random-token
COACH_DATA_DIR=./data
COACH_AUDIO_ROOT=./audio
COACH_MAX_UPLOAD_MB=100
COACH_MAX_COACHING_CHARS=100000
# Optional live transcription; audio leaves your machine for this provider.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Optional semantic coaching; transcript/context leave your machine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
